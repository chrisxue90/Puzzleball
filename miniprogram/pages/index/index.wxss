.menu-screen {
  min-height: 100vh;
  padding: 42rpx 34rpx 28rpx;
  box-sizing: border-box;
  background: radial-gradient(circle at 50% 12%, #708880 0%, #506963 38%, #2d4542 100%);
}

.hero {
  position: relative;
  height: 520rpx;
  padding-top: 130rpx;
  box-sizing: border-box;
  text-align: center;
  perspective: 900rpx;
}

.mascots {
  position: absolute;
  top: 18rpx;
  left: 50%;
  width: 570rpx;
  height: 190rpx;
  transform: translateX(-50%);
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
}

.mascot {
  position: relative;
  width: 118rpx;
  height: 140rpx;
  border-radius: 58% 58% 48% 48%;
  box-shadow: inset 14rpx 12rpx 18rpx rgba(255,255,255,.45), inset -14rpx -18rpx 22rpx rgba(20,20,40,.28), 0 14rpx 18rpx rgba(11,29,27,.35);
}

.mascot.violet {
  margin-top: 14rpx;
  transform: scale(1.12);
}

.eye {
  position: absolute;
  top: 58rpx;
  width: 14rpx;
  height: 24rpx;
  border-radius: 50%;
  background: #172229;
  box-shadow: inset 4rpx 3rpx 0 #ffffff;
}

.eye.left { left: 34rpx; }
.eye.right { right: 34rpx; }

.brand-cn {
  position: relative;
  z-index: 3;
  color: #fff4ce;
  font-size: 54rpx;
  font-weight: 800;
  letter-spacing: 8rpx;
  text-shadow: 0 5rpx 0 #455553, 0 9rpx 12rpx #172c2a;
}

.brand-en {
  position: relative;
  z-index: 2;
  margin-top: -6rpx;
  color: #e9f2ef;
  font-family: Georgia, serif;
  font-size: 105rpx;
  font-weight: 700;
  line-height: 1;
  letter-spacing: -8rpx;
  text-shadow: 0 7rpx 0 #789293, 0 15rpx 4rpx #304947, 0 23rpx 20rpx rgba(7,20,20,.55);
  transform: rotate(-1deg);
}

.board-preview {
  width: 500rpx;
  height: 212rpx;
  margin: 30rpx auto 0;
  padding: 8rpx;
  box-sizing: border-box;
  display: grid;
  grid-template-columns: repeat(9, 1fr);
  grid-template-rows: repeat(3, 1fr);
  gap: 2rpx;
  background: #b9ae8e;
  border: 8rpx solid #d6c9a5;
  box-shadow: 0 22rpx 26rpx rgba(0,0,0,.35);
  transform: rotateX(55deg);
  transform-origin: top;
}

.preview-cell {
  display: flex;
  align-items: center;
  justify-content: center;
  border: 1rpx solid rgba(66,61,48,.4);
}

.preview-ball {
  width: 34rpx;
  height: 34rpx;
  border-radius: 50%;
  box-shadow: inset 5rpx 4rpx 5rpx rgba(255,255,255,.3), 0 3rpx 3rpx rgba(0,0,0,.28);
}

.menu-actions {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
}

.menu-button {
  min-height: 100rpx;
  margin: 0;
  padding: 0 30rpx 0 42rpx;
  border: 1rpx solid rgba(125,91,47,.45);
  border-radius: 20rpx;
  background: linear-gradient(#fff7df, #f1d59c);
  color: #39516b;
  box-shadow: inset 0 2rpx 0 #ffffff, 0 8rpx 16rpx rgba(18,35,34,.3);
  display: flex;
  align-items: center;
  justify-content: space-between;
  font-size: 36rpx;
  font-weight: 700;
  letter-spacing: 4rpx;
}

.menu-button.primary { background: linear-gradient(#fff8d9, #ffc95f); }
.menu-button.muted { opacity: .72; filter: saturate(.65); }
.button-note { color: #806e53; font-size: 21rpx; font-weight: 400; letter-spacing: 0; }

.settings-row {
  margin-top: 25rpx;
  display: flex;
  justify-content: center;
  gap: 42rpx;
  color: rgba(244,250,247,.78);
  font-size: 24rpx;
}

.settings-row label {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.settings-row switch { transform: scale(.7); }
.footer { margin-top: 15rpx; color: rgba(242,251,247,.5); text-align: center; font-size: 20rpx; }

.game-screen {
  min-height: 100vh;
  background: #203343;
}

.game-topbar {
  height: 118rpx;
  display: grid;
  grid-template-columns: 1fr 1.4fr 1fr;
  align-items: center;
  background: #f7f5ed;
  border-bottom: 8rpx solid #203343;
}

.game-topbar button {
  height: 100%;
  margin: 0;
  padding: 0 34rpx;
  border-radius: 0;
  background: transparent;
  color: #497bc2;
  font-size: 38rpx;
  line-height: 118rpx;
}

.game-topbar button:first-child { text-align: left; }
.game-topbar button:last-child { text-align: right; }
.score-box { display: flex; flex-direction: column; align-items: center; color: #111111; font-size: 39rpx; font-weight: 600; }
.score-box .timer { margin-top: 4rpx; color: #bd2b2b; font-size: 23rpx; }

.board {
  position: relative;
  width: 750rpx;
  height: 750rpx;
  padding: 1rpx;
  box-sizing: border-box;
  display: grid;
  grid-template-columns: repeat(9, minmax(0, 1fr));
  grid-template-rows: repeat(9, minmax(0, 1fr));
  gap: 1rpx;
  overflow: hidden;
  background: #3e443e;
}

.cell {
  width: 100%;
  height: 100%;
  min-width: 0;
  min-height: 0;
  margin: 0;
  padding: 0;
  border-radius: 0;
  background: #f0eee3;
  display: flex;
  align-items: center;
  justify-content: center;
  line-height: 1;
}

.cell.selected { background: #fffbd8; }
.cell-hover { background: #f8f2d8; }

.ball, .mini-ball, .preview-ball {
  border: 1rpx solid rgba(20,27,30,.22);
  box-sizing: border-box;
  filter: saturate(1.18) contrast(1.08);
}

.ball {
  width: 74%;
  height: 74%;
  border-radius: 50%;
  box-shadow: inset 5rpx 4rpx 8rpx rgba(255,255,255,.28), 0 3rpx 4rpx rgba(35,43,39,.34);
}

.selected .ball { animation: selected-hop .72s ease-in-out infinite; }
.red { background: linear-gradient(to bottom, #c90909 0%, #ff251a 64%, #fff1dc 100%); }
.yellow { background: linear-gradient(to bottom, #ffc400 0%, #ffe21a 64%, #fffceb 100%); }
.cyan { background: linear-gradient(to bottom, #007cb9 0%, #04b9ee 64%, #ecffff 100%); }
.violet { background: linear-gradient(to bottom, #321078 0%, #6736ce 64%, #f0eaff 100%); }
.orange { background: linear-gradient(to bottom, #ed6900 0%, #ff9412 64%, #fff1d8 100%); }
.lime { background: linear-gradient(to bottom, #55a800 0%, #82d414 64%, #f2ffe4 100%); }
.pink { background: linear-gradient(to bottom, #df0058 0%, #ff3d91 64%, #fff0f6 100%); }

.next-strip {
  min-height: 112rpx;
  padding: 10rpx 26rpx;
  box-sizing: border-box;
  display: grid;
  grid-template-columns: auto 1fr;
  align-items: center;
  gap: 30rpx;
  color: #0a7ff4;
  background: #203343;
  font-size: 40rpx;
  font-weight: 600;
}

.next-balls { display: flex; align-items: center; gap: 20rpx; }
.mini-ball { width: 64rpx; height: 64rpx; border-radius: 50%; box-shadow: inset 4rpx 3rpx 6rpx rgba(255,255,255,.3), 0 3rpx 4rpx rgba(0,0,0,.35); }
.game-note { padding: 8rpx; color: rgba(255,255,255,.3); text-align: center; font-size: 20rpx; letter-spacing: 3rpx; }

.game-over {
  position: absolute;
  z-index: 5;
  top: 105rpx;
  right: 105rpx;
  bottom: 105rpx;
  left: 105rpx;
  padding: 45rpx;
  border: 1rpx solid rgba(255,255,255,.55);
  border-radius: 32rpx;
  background: rgba(34,54,50,.96);
  color: #fff3d6;
  box-shadow: 0 22rpx 58rpx rgba(12,25,23,.55);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 18rpx;
}

.over-title { font-size: 35rpx; font-weight: 700; }
.over-score { font-size: 100rpx; font-weight: 700; line-height: 1; }
.over-best { color: rgba(255,255,255,.7); font-size: 23rpx; }
.game-over button { width: 260rpx; margin: 0; border-radius: 15rpx; font-size: 29rpx; font-weight: 700; line-height: 76rpx; }
.game-over .replay { background: #ffe3a2; color: #344c5c; }
.game-over .back { background: rgba(255,255,255,.12); color: #f2f2df; }

@keyframes selected-hop {
  0%, 100% { transform: translateY(0) scale(1); }
  45% { transform: translateY(-10%) scale(1.05); }
}
